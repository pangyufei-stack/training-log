# Copy to functions/.env before deploying. Nothing secret goes in this file.

# Your timezone: decides what "today" means and when the daily sync runs.
APP_TIMEZONE=Europe/London

# Name shown in the page header.
DISPLAY_NAME=My training log

# Public address of the site, used for the Withings login redirect.
# Example: https://your-project-id.web.app
PUBLIC_URL=
