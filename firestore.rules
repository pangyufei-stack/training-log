rules_version = '2';

// There is no server: these rules are the only access control.
//
// Access works by secret link. config/keys holds two random keys (owner, trainer).
// A browser signs in anonymously, then writes the key from its link into
// sessions/{its uid}; that write is only accepted if the key matches. Every other
// rule looks the key up again, so replacing the trainer key in config/keys cuts
// off every device that used the old link at once.

service cloud.firestore {
  match /databases/{db}/documents {

    function keys() { return get(/databases/$(db)/documents/config/keys).data; }
    function sessionKey() { return get(/databases/$(db)/documents/sessions/$(request.auth.uid)).data.key; }
    function isOwner() { return request.auth != null && sessionKey() == keys().ownerKey; }
    function isTrainer() { return request.auth != null && sessionKey() == keys().trainerKey; }
    function isMember() { return isOwner() || isTrainer(); }
    function role() { return isOwner() ? 'owner' : 'trainer'; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    match /sessions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string
        && (request.resource.data.key == keys().ownerKey || request.resource.data.key == keys().trainerKey);
    }

    match /config/keys {
      allow read: if isOwner();
      // The owner can replace the trainer key. The owner key is changed only by an admin.
      allow update: if isOwner() && onlyChanges(['trainerKey'])
        && request.resource.data.trainerKey is string && request.resource.data.trainerKey.size() >= 32;
    }

    match /meta/public {
      allow read: if isMember();
    }

    // Written by the sync job; the owner may mark a source as pending after connecting it.
    match /private/status {
      allow read, create, update: if isOwner();
    }
    // Tokens. The browser may write them (Withings sign-in, pasted Garmin tokens, disconnect)
    // but can never read them back.
    match /private/connections {
      allow create, update: if isOwner();
    }
    // Garmin email + password for one sign-in by the sync job, which then deletes it. Write-only.
    match /private/garminLogin {
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'password'])
        && request.resource.data.email is string && request.resource.data.password is string;
    }
    // The owner's Withings developer app; the owner's browser needs it to finish the Withings sign-in.
    match /private/withingsApp {
      allow read, create, update: if isOwner()
        && (request.method == 'get' || request.resource.data.keys().hasOnly(['clientId', 'clientSecret']));
    }

    function validMacros(m) {
      return m.keys().hasOnly(['kcal', 'protein', 'carbs', 'fat', 'source']) && m.source == 'manual'
        && m.kcal is number && m.protein is number && m.carbs is number && m.fat is number
        && m.kcal >= 0 && m.kcal <= 20000 && m.protein >= 0 && m.carbs >= 0 && m.fat >= 0;
    }
    match /days/{date} {
      allow read: if isMember();
      // The owner can type in (or clear) a day's macros. Everything else comes from the sync job.
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['date', 'macros'])
        && request.resource.data.date == date && isDate(date) && validMacros(request.resource.data.macros);
      allow update: if isOwner() && onlyChanges(['macros'])
        && (!('macros' in request.resource.data) || validMacros(request.resource.data.macros));
    }

    match /activities/{id} {
      allow read: if isMember();
    }

    function validTags(d) {
      return isDate(d.date) && d.kind in ['progress', 'meal']
        && (d.pose == null || d.pose in ['front', 'side', 'back'])
        && d.note is string && d.note.size() <= 500;
    }
    function canEditPhoto(d) { return isOwner() || (isTrainer() && d.uploadedBy == 'trainer'); }

    // Photo metadata plus a small preview. The full photo lives in photoFiles/{same id}.
    match /photos/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['date', 'kind', 'pose', 'note', 'thumb', 'uploadedBy', 'createdAt'])
        && validTags(request.resource.data)
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 100000
        && request.resource.data.uploadedBy == role()
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(db)/documents/photoFiles/$(id));
      allow update: if canEditPhoto(resource.data) && onlyChanges(['date', 'kind', 'pose', 'note'])
        && validTags(request.resource.data);
      allow delete: if canEditPhoto(resource.data);
    }
    match /photoFiles/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && existsAfter(/databases/$(db)/documents/photos/$(id));
      allow delete: if isOwner()
        || (isTrainer() && get(/databases/$(db)/documents/photos/$(id)).data.uploadedBy == 'trainer');
    }
  }
}
